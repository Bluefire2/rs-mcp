# Copy to .env and fill in. .env is git-ignored.

# Your RuneScape name and hiscores type:
# regular | ironman | hardcore_ironman | ultimate | deadman | seasonal
DEFAULT_RSN=
DEFAULT_ACCOUNT_TYPE=regular

# Sent in the User-Agent of every outbound request (the OSRS Wiki asks for contact info).
CONTACT=you@example.com

# Optional: a Wise Old Man API key raises their rate limit from 20 to 100 requests/minute.
WOM_API_KEY=

# Bind address. Cloud Run sets PORT itself; use HOST=0.0.0.0 in containers.
HOST=127.0.0.1
PORT=8000

# The URL clients use to reach this server (no /mcp). OAuth issuer; Google redirect URI is
# <PUBLIC_BASE_URL>/auth/callback.
PUBLIC_BASE_URL=http://localhost:8000

# Auth: "google" (sign-in restricted to ALLOWED_EMAIL) or "none" (local dev, public data only).
AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=
# Generate both with:  python -m osrs_mcp.keys
JWT_SIGNING_KEY=
STORAGE_ENCRYPTION_KEY=

# Storage for OAuth state and RuneLite snapshots: file (local), memory (tests), firestore (Cloud Run)
STORE_BACKEND=file
STORE_DIR=var/store

# Bank, inventory and gear pushed by the Group Ironmen Tracker RuneLite plugin. Ingest stays
# disabled until both GIM_GROUP and INGEST_TOKEN are set. In the plugin set:
#   Group Name = GIM_GROUP, Group Token = INGEST_TOKEN, Server base URL override = PUBLIC_BASE_URL
# Generate INGEST_TOKEN with:  python -m osrs_mcp.keys
GIM_GROUP=
INGEST_TOKEN=
# Comma-separated RuneScape names allowed to push data; blank means DEFAULT_RSN only.
INGEST_ALLOWED_RSNS=
# Debugging: save every authenticated plugin update body raw to this directory. Unset normally.
INGEST_CAPTURE_DIR=
