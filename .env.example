# Copy to .env and fill in. .env is git-ignored.

# Your RuneScape name and hiscores type:
# regular | ironman | hardcore_ironman | ultimate | deadman | seasonal
DEFAULT_RSN=
DEFAULT_ACCOUNT_TYPE=regular

# Sent in the User-Agent of every outbound request (the OSRS Wiki asks for contact info).
CONTACT=you@example.com

# Optional: a Wise Old Man API key raises their rate limit from 20 to 100 requests/minute.
WOM_API_KEY=

# Bind address. Cloud Run sets PORT itself; use HOST=0.0.0.0 in containers.
HOST=127.0.0.1
PORT=8000
